{{- /* jekyll-feed equivalent: latest 10 posts. Entry ids kept as Jekyll wrote them. */ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<feed xmlns="http://www.w3.org/2005/Atom">
 <link href="{{ "feed.xml" | absURL }}" rel="self" type="application/atom+xml"/>
 <link href="{{ site.BaseURL }}" rel="alternate" type="text/html"/>
 <updated>{{ now.UTC.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</updated>
 <id>/feed.xml</id>
 <title type="html">{{ site.Title }}</title>
 <subtitle>{{ site.Params.description }}</subtitle>
 {{ range first 10 (where site.RegularPages "Section" "posts") }}
 <entry>
   <title type="html">{{ .Title }}</title>
   <link href="{{ .Permalink }}" rel="alternate" type="text/html" title="{{ .Title }}"/>
   <published>{{ .Date.UTC.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</published>
   <updated>{{ .Date.UTC.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</updated>
   <id>{{ strings.TrimSuffix ".html" .RelPermalink }}</id>
   <content type="html" xml:base="{{ .Permalink }}">{{ .Content | transform.XMLEscape | safeHTML }}</content>
   {{ with .Params.author }}<author><name>{{ . }}</name></author>{{ end }}
   {{ range .Params.tags }}<category term="{{ . }}"/>{{ end }}
   <summary type="html">{{ .Summary | transform.XMLEscape | safeHTML }}</summary>
 </entry>
 {{ end }}
</feed>
